row=block;endFill=1;strokeColor=#000000;fontSize=11;dashed=1;strokeWidth=2;" edge="1" parent="1" source="s117" target="s126"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lg135" value="Solid = written in code. Dashed = planned / source not in the repository. Raw readings never leave the ESP32." style="text;html=1;align=left;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="535" width="700" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Connections checklist" id="chk1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1169" pageHeight="827"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c0" value="CONNECTIONS TO CHECK (arrows). Direction is FROM -&gt; TO. (D) = dashed." style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c1" value="" style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c2" value="PAGE 1 - System Architecture" style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="68" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c3" value="1  Capacitive soil sensor -&gt; ESP32 edge controller" style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="92" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c4" value="2  DHT11 temp / humidity -&gt; ESP32 edge controller" style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="116" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c5" value="3  Hall-effect flow sensor -&gt; ESP32 edge controller" style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="140" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c6" value="4  OpenWeatherMap forecast API -&gt; ESP32 edge controller (D) label: forecast" style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="164" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c7" value="5  ESP32 edge controller -&gt; Raw sensor log, label: raw rows" style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="188" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c8" value="6  ESP32 edge controller -&gt; Relay module, label: on / off" style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="212" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c9" value="7  Relay module -&gt; Pump / solenoid valve" style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="236" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c10" value="8  ESP32 edge controller -&gt; MQTT broker, label: 1 summary row/min + alert events (MQTT/TLS)" style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="260" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c11" value="9  MQTT broker -&gt; FastAPI backend" style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="284" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c12" value="10 FastAPI backend -&gt; PostgreSQL" style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="308" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c13" value="11 PostgreSQL -&gt; Predictive model (D) label: training data" style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="332" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c14" value="12 Predictive model -&gt; FastAPI backend (D) label: advice" style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="356" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c15" value="13 FastAPI backend -&gt; Android app (D) label: REST" style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="380" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c16" value="14 FastAPI backend -&gt; MQTT broker (D) label: advisory commands" style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="404" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c17" value="15 MQTT broker -&gt; ESP32 edge controller (D) label: advisory commands" style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="428" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c18" value="" style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="452" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c19" value="PAGE 2 - Software layers" style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="476" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c20" value="Firmware: Sensor drivers -&gt; Local controller; Sensor drivers -&gt; Data logger (samples);" style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="500" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c21" value="  Command arbitration -&gt; Local controller (safe commands only); Local controller -&gt; Data logger (events);" style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="524" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c22" value="  Data logger -&gt; Comms" style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="548" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c23" value="Backend: MQTT subscriber/publisher -&gt; Ingest + validation -&gt; PostgreSQL -&gt; REST API;" style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="572" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c24" value="  PostgreSQL -&gt; Predictive advisor (D); Predictive advisor -&gt; REST API (D)" style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="596" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c25" value="App (all D): Login -&gt; Dashboard -&gt; Analytics -&gt; Alerts + override" style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="620" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c26" value="Between layers: Comms -&gt; MQTT subscriber/publisher (MQTT over TLS: summary rows, events, acks);" style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="644" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c27" value="  REST API -&gt; Dashboard (D) (REST JSON); MQTT subscriber/publisher -&gt; Comms (D) (advisory commands)" style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="668" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c28" value="" style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="692" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c29" value="KNOWN ISSUE: when the file was opened, the boxes showed but the arrows did not." style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="716" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c30" value="The arrows ARE in the file (15 on page 1, 15 on page 2) but may not render in every viewer" style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="740" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c31" value="or theme. If they are missing, redraw them from this list, or switch draw.io to the light theme" style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="764" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c32" value="(Extras &gt; Appearance) and check again." style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="788" width="1100" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>