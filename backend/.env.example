# Copy to .env and fill in. Never commit the real .env.
DATABASE_URL=postgresql+psycopg2://jalbhoomi:CHANGE_ME@postgres:5432/jalbhoomi
MQTT_ENABLED=true
MQTT_HOST=mosquitto
MQTT_PORT=8883
MQTT_USER=backend
MQTT_PASS=CHANGE_ME
MQTT_TLS=true
MQTT_CA_CERT=/certs/ca.crt
MQTT_TOPIC_PREFIX=jalbhoomi
# Required for POST/PUT endpoints (send as X-API-Key). Use a long random value.
BACKEND_API_KEY=CHANGE_ME_LONG_RANDOM

# Optional Firebase (Realtime Database mirror + push alerts). Needs your own project.
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS=/run/secrets/firebase-service-account.json
FIREBASE_DB_URL=https://YOUR-PROJECT-default-rtdb.REGION.firebasedatabase.app
# Firebase UIDs allowed to send commands from the Android app (comma separated). Empty = nobody.
ALLOWED_FIREBASE_UIDS=
# true = GET endpoints also need a key or a valid Firebase login
REQUIRE_AUTH_FOR_READS=false

# Scheduled prediction job (stores advisory predictions; needs a model trained on real data)
PREDICTION_JOB_ENABLED=true
PREDICTION_INTERVAL_S=900
